MAIN
MOVE TEMP 1001 4
MOVE TEMP 1002 HALLOCATE TEMP 1001
MOVE TEMP 1003 F_doit
HSTORE TEMP 1002 0 TEMP 1003
MOVE TEMP 1004 12
MOVE TEMP 1005 HALLOCATE TEMP 1004
HSTORE TEMP 1005 0 TEMP 1002
MOVE TEMP 1006 0
HSTORE TEMP 1005 4 TEMP 1006
MOVE TEMP 1007 0
HSTORE TEMP 1005 8 TEMP 1007
HLOAD TEMP 1008 TEMP 1005 0
HLOAD TEMP 1009 TEMP 1008 0
MOVE TEMP 1010 CALL TEMP 1009 ( TEMP 1005 )
PRINT TEMP 1010
END
F_doit [1]
BEGIN
MOVE TEMP 1011 5
HSTORE TEMP 0 4 TEMP 1011
MOVE TEMP 1012 7
HSTORE TEMP 0 8 TEMP 1012
HLOAD TEMP 1013 TEMP 0 4
HLOAD TEMP 1014 TEMP 0 8
MOVE TEMP 1015 PLUS TEMP 1013 TEMP 1014
RETURN TEMP 1015
END
