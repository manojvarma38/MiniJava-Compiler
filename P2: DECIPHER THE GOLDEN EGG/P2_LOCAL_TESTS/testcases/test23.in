class Main {
  public static void main(String[] args) {
    System.out.println(new LocalShadowsField().start());
  }
}

class LocalShadowsField {
  Function<Box,Box> handler; // field

  public int start() {
    Function<Box,Box> handler; // local shadows field
    handler = (x) -> x;
    handler = (y) -> y;   // assigns to field (explicitly via this)
    return 2;
  }
}

class Box { }
